{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "client/src/api/generated/**",
    "contract/generated/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/blob-report/**",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    ".release-please-manifest.json",
    ".idea/**",
    ".github/**"
  ]
}
